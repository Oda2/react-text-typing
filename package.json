{
  "type": "module",
  "name": "react-text-typing",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "version": "0.7.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "homepage": "https://renato-oda2.gitbook.io/react-text-typing",
  "license": "MIT",
  "author": {
    "name": "Renato Oda",
    "email": "renato.oda2@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Oda2/react-text-typing"
  },
  "keywords": [
    "react",
    "library",
    "typing",
    "animation"
  ],
  "bugs": {
    "url": "https://github.com/oda2/react-text-typing/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./dist/style.css",
    "./assets/logo.png": "./assets/logo.png"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build": "storybook build",
    "build:lib": "tsc && vite build",
    "lint": "eslint .",
    "format": "prettier . --write --ignore-unknown",
    "cypress": "cypress"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.60.1",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-links": "^10.6.8",
    "@storybook/react": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.1.1",
    "cypress": "^16.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest-dom": "^5.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-storybook": "^10.6.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
